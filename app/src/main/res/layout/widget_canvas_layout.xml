<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The Canvas-rendered dot-matrix bitmap -->
    <ImageView
        android:id="@+id/widget_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

    <!-- Live HH:mm:ss for seconds widgets. A bitmap can only be redrawn about once a minute,
         but TextClock is ticked every second by the launcher itself. The bitmap behind it
         draws the background, label and date; the weights keep the time in the middle band.
         Launchers can't load an app's bundled fonts in widgets, so this uses Nothing OS's
         system dot-matrix font by family name; other phones fall back to the default font. -->
    <LinearLayout
        android:id="@+id/live_clock_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="27" />

        <TextClock
            android:id="@+id/live_clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="NDot57-Aligned"
            android:format24Hour="HH:mm:ss"
            android:format12Hour="HH:mm:ss"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="#FFFFFFFF" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="37" />
    </LinearLayout>

    <!-- Live stopwatch / countdown for running timers, ticked by the launcher every second.
         Same middle band and Nothing dot font as the live clock above. -->
    <LinearLayout
        android:id="@+id/live_timer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24" />

        <Chronometer
            android:id="@+id/live_timer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="40"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="NDot57-Aligned"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="#FFFFFFFF" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36" />
    </LinearLayout>

    <!-- Animated Soundwave: the launcher flips through these frames while the widget is visible.
         Frames are alpha-only bitmaps tinted with setColorFilter. -->
    <ViewFlipper
        android:id="@+id/soundwave_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="200"
        android:visibility="gone">

        <ImageView android:id="@+id/wave_frame_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/wave_frame_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/wave_frame_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/wave_frame_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/wave_frame_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/wave_frame_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </ViewFlipper>

    <!-- Tap regions built at runtime (rows of cells) for widgets with several buttons. -->
    <LinearLayout
        android:id="@+id/dynamic_regions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Multi-region tap quadrants for 2x2 toggles (using FrameLayout for strict RemoteViews compatibility) -->
    <LinearLayout
        android:id="@+id/multi_region_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/click_region_tl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout
                android:id="@+id/click_region_tr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/click_region_bl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout
                android:id="@+id/click_region_br"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
