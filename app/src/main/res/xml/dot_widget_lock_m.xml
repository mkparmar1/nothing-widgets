<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-safe wide provider, lock screen only: phones whose lock screen hosts standard widgets
     (e.g. Android 16 QPR2+ on Pixel) list it there. Not offered on the home screen, where the
     regular providers already cover every design. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_canvas_layout"
    android:configure="com.example.ui.config.WidgetConfigureActivity"
    android:widgetFeatures="reconfigurable"
    android:previewImage="@drawable/widget_preview_m"
    android:description="@string/widget_lock_desc_m"
    android:widgetCategory="keyguard" />
