<?xml version="1.0" encoding="utf-8"?>
<!-- Back up widget settings, but never the Home Assistant server and token: the token is
     encrypted with a key that stays on this phone, and it shouldn't leave the device anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dot_widgets_home.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dot_widgets_home.xml" />
    </device-transfer>
</data-extraction-rules>
